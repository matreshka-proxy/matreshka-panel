server_tokens off;
limit_req_zone $binary_remote_addr zone=matreshka_setup:10m rate=10r/m;

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    location /.well-known/acme-challenge/ {
        root /var/www/matreshka-acme;
    }

    location / {
        return 301 https://__PUBLIC_IP__$request_uri;
    }
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name _;

    ssl_certificate /etc/letsencrypt/live/__PUBLIC_IP__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__PUBLIC_IP__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:MATRESHKA_SETUP_TLS:2m;
    client_max_body_size 64k;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    location ^~ /api/v1/setup {
        limit_req zone=matreshka_setup burst=10 nodelay;
        access_log off;
        proxy_pass http://127.0.0.1:8181;
        proxy_http_version 1.1;
        proxy_set_header Host __PUBLIC_IP__;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location = /healthz {
        access_log off;
        proxy_pass http://127.0.0.1:8181;
    }

    location = /readyz {
        access_log off;
        proxy_pass http://127.0.0.1:8181;
    }

    location ^~ /admin/setup {
        access_log off;
        proxy_pass http://127.0.0.1:8181;
        proxy_http_version 1.1;
        proxy_set_header Host __PUBLIC_IP__;
        proxy_set_header X-Forwarded-Proto https;
    }

    location = /app.js {
        access_log off;
        proxy_pass http://127.0.0.1:8181;
    }

    location ^~ /assets/ {
        access_log off;
        proxy_pass http://127.0.0.1:8181;
    }

    location ^~ /vendor/ {
        access_log off;
        proxy_pass http://127.0.0.1:8181;
    }

    location ~ ^/brand-mark(?:-success)?\.png$ {
        access_log off;
        proxy_pass http://127.0.0.1:8181;
    }

    location / {
        return 404;
    }
}
