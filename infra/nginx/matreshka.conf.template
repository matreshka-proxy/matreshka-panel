map $http_upgrade $matreshka_connection {
    default upgrade;
    '' close;
}

server_tokens off;
limit_req_zone $binary_remote_addr zone=matreshka_auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=matreshka_api:10m rate=20r/s;

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    return 444;
}

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    location /.well-known/acme-challenge/ {
        root /var/www/matreshka-acme;
    }

    location / {
        return 301 https://__DOMAIN__$request_uri;
    }
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name _;

    ssl_certificate /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    return 421;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __DOMAIN__;

    ssl_certificate /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:MATRESHKA_TLS:10m;
    ssl_session_timeout 1d;
    client_max_body_size 1m;
    # Bun corrupts streamed responses to HTTP/1.0 upstream requests by appending
    # request framing bytes. Keep every application-edge proxy hop on HTTP/1.1.
    proxy_http_version 1.1;

    add_header Strict-Transport-Security "max-age=15552000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    # The Hysteria auth backend is localhost-only. Never route it from the public edge.
    location ^~ /internal/ {
        access_log off;
        return 404;
    }

    # XHTTP query strings may contain padding and must never enter logs.
    location __XHTTP_PATH__ {
        access_log off;
        proxy_pass http://127.0.0.1:10000;
        proxy_http_version 1.1;
        proxy_redirect off;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_set_header Host __DOMAIN__;
        proxy_set_header X-Forwarded-Proto https;
    }

    # Invitations, subscriptions and route URLs carry bearer secrets.
    location ~ ^/(invite|subscriptions|routes)/ {
        access_log off;
        proxy_pass http://127.0.0.1:8181;
        proxy_http_version 1.1;
        client_max_body_size 128k;
        proxy_set_header Host __DOMAIN__;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location ^~ /api/v1/auth/ {
        limit_req zone=matreshka_auth burst=10 nodelay;
        client_max_body_size 64k;
        access_log off;
        proxy_pass http://127.0.0.1:8181;
        proxy_http_version 1.1;
        proxy_set_header Host __DOMAIN__;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location ^~ /api/v1/ {
        limit_req zone=matreshka_api burst=40 nodelay;
        access_log off;
        proxy_pass http://127.0.0.1:8181;
        proxy_http_version 1.1;
        proxy_set_header Host __DOMAIN__;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $matreshka_connection;
    }

    location ~ ^/(admin|app\.js|vendor/) {
        access_log off;
        proxy_pass http://127.0.0.1:8181;
        proxy_http_version 1.1;
        proxy_set_header Host __DOMAIN__;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $matreshka_connection;
    }

    # Everything else is the neutral cover page from Matreshka.
    location / {
        proxy_pass http://127.0.0.1:8181;
        proxy_set_header Host __DOMAIN__;
        proxy_set_header X-Forwarded-Proto https;
    }
}
