{
  "name": "matreshka-panel",
  "version": "0.1.0-rc.2",
  "packageManager": "bun@1.3.13",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "MATRESHKA_DEMO=1 MATRESHKA_DATA_DIR=.data bun --watch src/server/index.ts",
    "dev:web": "bun run assets && bunx bimba src/web/app.imba --outdir public --watch",
    "build": "bun run build:web && bun run build:server && bun run build:cli",
    "build:web": "bun run assets && bunx bimba src/web/app.imba --outdir public --minify",
    "build:server": "bun build src/server/index.ts --compile --target=bun-linux-x64-baseline --outfile dist/matreshka",
    "build:cli": "bun run build:cli:mac && bun run build:cli:linux",
    "build:cli:mac": "bun build src/cli/index.ts --compile --target=bun-darwin-arm64 --outfile dist/matreshkactl-darwin-arm64",
    "build:cli:linux": "bun build src/cli/index.ts --compile --target=bun-linux-x64-baseline --outfile dist/matreshkactl-linux-amd64",
    "release:linux": "bun scripts/release.ts",
    "assets": "bun scripts/assets.ts",
    "check": "bunx tsc --noEmit && bun run build:web && bun test",
    "test": "bun test",
    "test:agent": "cd agent && go test ./...",
    "start": "bun src/server/index.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@modelcontextprotocol/sdk": "^1.17.4",
    "@phosphor-icons/web": "^2.1.2",
    "@simplewebauthn/server": "^13.2.2",
    "codemirror": "^6.0.2",
    "imba": "^2.0.0-alpha.247",
    "qrcode": "^1.5.4",
    "yaml": "^2.8.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/qrcode": "^1.5.5",
    "bimba-cli": "^0.2.6",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "esbuild": "0.25.0"
  }
}
